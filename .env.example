# Application Configuration
VITE_APP_NAME=Knowledge Management System
VITE_ENVIRONMENT=development

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=500000

# Development Server
VITE_HOST=0.0.0.0
VITE_PORT=5170

# JWT Configuration
VITE_JWT_TOKEN_KEY=access_token
VITE_JWT_REFRESH_TOKEN_KEY=refresh_token
VITE_JWT_TOKEN_EXPIRY_WARNING_MINUTES=5

# File Upload Configuration
VITE_MAX_FILE_SIZE_MB=100
VITE_ALLOWED_FILE_TYPES=pdf

# UI Configuration
VITE_TOAST_AUTO_DISMISS_MS=3000
VITE_PAGINATION_ROWS=10

# Share Link Configuration (biarkan kosong jika ingin otomatis menggunakan domain browser)
VITE_SHARE_BASE_URL=

